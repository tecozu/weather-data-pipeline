# Copy to .env and fill in. Never commit .env.

# --- Weather API ---------------------------------------------------------
WEATHER_API_KEY=your-weatherstack-key
WEATHER_CITIES=Rio de Janeiro;Sao Paulo;Belo Horizonte
# 1 = deterministic fake data, no API calls
WEATHER_API_MOCK=0

# --- Warehouse (Postgres) --------------------------------------------------
POSTGRES_DB=weather
POSTGRES_USER=weather
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Airflow metadata DB ---------------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-too
# absolute path of this repo on the host (mounted into the dbt container)
HOST_PROJECT_DIR=/absolute/path/to/weather-data-pipeline
# group id of /var/run/docker.sock on the host (lets Airflow start the dbt container)
DOCKER_GID=0

# --- Superset ---------------------------------------------------------------
DATABASE_DIALECT=postgresql
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DB=superset_db
DATABASE_USER=superset
DATABASE_PASSWORD=change-me-three
SUPERSET_SECRET_KEY=generate-a-long-random-string
ADMIN_PASSWORD=change-me-admin
REDIS_HOST=redis
REDIS_PORT=6379
SUPERSET_LOAD_EXAMPLES=no
